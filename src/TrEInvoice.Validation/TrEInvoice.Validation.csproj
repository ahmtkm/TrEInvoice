<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>TrEInvoice.Validation</PackageId>
    <Version>0.1.0</Version>
    <Authors>TrEInvoice contributors</Authors>
    <Description>Generic structural and monetary validation for TrEInvoice invoice documents.</Description>
    <PackageTags>e-invoice;invoice;validation;UBL</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/ahmtkm/TrEInvoice</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <IsPackable>true</IsPackable>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="..\TrEInvoice.Core\TrEInvoice.Core.csproj" /></ItemGroup>
</Project>
